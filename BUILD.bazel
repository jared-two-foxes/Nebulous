# Root BUILD.bazel - Nebulous workspace root (Bazel 7+ / bzlmod)

# This file defines the overall workspace targets and aggregates library exports.

# ============================================================================
# WORKSPACE DEFAULTS
# ============================================================================

exports_files([
    "vcpkg.json",
    ".bazelrc",
])

# ============================================================================
# AGGREGATE TARGETS
# ============================================================================

# Build all engine libraries (Common, Alpha)
# Audio deferred until openal-soft integration (Phase 5)
filegroup(
    name = "engine_libs",
    srcs = [
        "//Source/Nebulae:all_libs",
    ],
    visibility = ["//visibility:public"],
)

# Build all tests
alias(
    name = "all_tests",
    actual = "//tests:all_tests",
    visibility = ["//visibility:public"],
)

# Build all currently enabled samples
filegroup(
    name = "all_samples",
    srcs = [
        "//Samples/AlphaQuad:alpha_quad",
        "//Samples/Application:application",
        "//Samples/BasicRig:basic_rig",
        #"//Samples/Entity:entity",
        #"//Samples/GuiTest:gui_test",
        "//Samples/Simple:simple",
    ],
    visibility = ["//visibility:public"],
)

# Top-level aggregator: bazel build //... builds everything available
# Includes engine libraries and all enabled samples.
filegroup(
    name = "all",
    srcs = [
        ":engine_libs",
        ":all_samples",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# CODE FORMATTING & LINTING
# ============================================================================

# buildifier_check: Validate BUILD/MODULE file formatting
# This is a simple test that runs buildifier in check mode
alias(
    name = "buildifier_check",
    actual = "@buildifier_prebuilt//:buildifier",
)

# buildifier_fix: Auto-format BUILD/MODULE files
# This is a simple binary that runs buildifier in fix mode
alias(
    name = "buildifier_fix",
    actual = "@buildifier_prebuilt//:buildifier",
)

# ============================================================================
# COMPILE COMMANDS (for clangd / clang-tidy)
# ============================================================================
load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")

refresh_compile_commands(
    name = "refresh_compile_commands",
    targets = {
        "//:engine_libs": "",
        "//tests:all_tests": "",
        "//:all_samples": "",
    },
)

# ============================================================================
# DOCUMENTATION TARGETS (Reference only, not compiled)
# ============================================================================

filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "AGENTS.md",
        ],
)
