# Root BUILD.bazel - Nebulous workspace root (Bazel 7+ / bzlmod)

# This file defines the overall workspace targets and aggregates library exports.

# ============================================================================
# WORKSPACE DEFAULTS
# ============================================================================

exports_files([
    "vcpkg.json",
    ".bazelrc",
])

# ============================================================================
# AGGREGATE TARGETS
# ============================================================================

# Build all engine libraries (Common, Alpha)
# Audio deferred until openal-soft integration (Phase 5)
filegroup(
    name = "engine_libs",
    srcs = [
        "//Source/Nebulae:all_libs",
    ],
    visibility = ["//visibility:public"],
)

# Build all tests
alias(
    name = "all_tests",
    actual = "//tests:all_tests",
    visibility = ["//visibility:public"],
)

# Top-level aggregator: bazel build //... builds everything available
# RenderSystems plugins and Samples will be added in Phases 5 and 6.
filegroup(
    name = "all",
    srcs = [
        ":engine_libs",
    ],
    visibility = ["//visibility:public"],
)

# ============================================================================
# CODE FORMATTING & LINTING
# ============================================================================

# buildifier_check: Validate BUILD/MODULE file formatting
# This is a simple test that runs buildifier in check mode
alias(
    name = "buildifier_check",
    actual = "@buildifier_prebuilt//:buildifier",
)

# buildifier_fix: Auto-format BUILD/MODULE files
# This is a simple binary that runs buildifier in fix mode
alias(
    name = "buildifier_fix",
    actual = "@buildifier_prebuilt//:buildifier",
)

# ============================================================================
# DOCUMENTATION TARGETS (Reference only, not compiled)
# ============================================================================

filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "AGENTS.md",
        ],
)
