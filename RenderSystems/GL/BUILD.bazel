load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# ============================================================================
# BUILD.bazel — Nebulous GL 3.0 Render Plugin (DLL)
# RenderSystems/GL/BUILD.bazel
# ============================================================================
#
# Phase 6 of Bazel migration. Produces nebulous_gl3.dll loaded at runtime
# by Alpha::CreateRenderSystem() for the OPENGL_3 renderer type.
#
# Depends on: Common (via Alpha), Alpha, opengl32.lib (Windows SDK)
# ============================================================================

cc_library(
    name = "gl_renderer_core",
    srcs = glob([
        "Sources/**/*.cpp",
    ]) + [
        "config.h",
        "glext.h",
    ],
    hdrs = glob(["Includes/**/*.h"]),
    includes = ["."],  # for <Config.h>, <glext.h>, <Includes/...>
    features = ["-layering_check"],
    copts = [
        "/std:c++20",
        "/DWIN32",
        "/DUNICODE",
        "/D_UNICODE",
    ],
    linkopts = [
        "opengl32.lib",
        "user32.lib",
        "gdi32.lib",
    ],
    deps = [
        "//Source/Nebulae/Alpha:alpha",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "nebulous_gl3",
    srcs = ["main.cpp"],
    includes = ["."],
    features = ["-layering_check"],
    copts = [
        "/std:c++20",
        "/DWIN32",
        "/DUNICODE",
        "/D_UNICODE",
    ],
    linkopts = [
        "opengl32.lib",
        "user32.lib",
        "gdi32.lib",
    ],
    deps = [
        ":gl_renderer_core",
    ],
    linkshared = True,
    visibility = ["//visibility:public"],
)
