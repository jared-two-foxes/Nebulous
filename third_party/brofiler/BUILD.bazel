# The original engine included Brofiler.h in Dependencies.h as a convenience
# include, but no .cpp files actually use any Brofiler macros or functions.
# This stub satisfies the #include directive without needing the actual
# brofiler library (which is deprecated / renamed to Optick).

cc_library(
    name = "brofiler",
    hdrs = ["Brofiler.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)