module(
    name = "nebulae",
    version = "0.0.1",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_license", version = "1.0.0")

# rules_python needed by Bazel embedded tools on Windows
bazel_dep(name = "rules_python", version = "1.7.0")

# Boost sub-modules from BCR (individual packages)
bazel_dep(name = "boost.any", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.filesystem", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.lexical_cast", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.signals2", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.format", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.xpressive", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.assign", version = "1.90.0.bcr.1")

# Graphics libraries
bazel_dep(name = "libpng", version = "1.6.54")
bazel_dep(name = "freetype", version = "2.14.1")

bazel_dep(name = "zlib", version = "1.3.1.bcr.8")

# Serialization
bazel_dep(name = "jsoncpp", version = "1.9.6.bcr.2")

# Testing
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# libpng uses bash for a genrule (pnglibconf copy), which fails on Windows.
# Patch to add a Windows-compatible cmd_bat fallback.
single_version_override(
    module_name = "libpng",
    version = "1.6.54",
    patches = ["//:patches/libpng_no_bash.patch"],
    patch_strip = 1,
)

bazel_dep(name = "boost.chrono", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.thread", version = "1.90.0.bcr.1")
